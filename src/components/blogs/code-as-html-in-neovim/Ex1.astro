  </button><div class="code-block rounded p-4">
    <div class="line wrap-break-word whitespace-pre-wrap">
      <span class="space"></span>
      <span class="Keyword text-base max-md:text-sm">local</span>
      <span class="space">&nbsp;</span>
      <span class="variable text-base max-md:text-sm">inspect</span>
      <span class="space">&nbsp;</span>
      <span class="Operator text-base max-md:text-sm">=</span>
      <span class="space">&nbsp;</span>
      <span class="variable text-base max-md:text-sm">vim</span>
      <span class="Delimiter text-base max-md:text-sm">.</span>
      <span class="Function text-base max-md:text-sm">inspect_pos</span>
      <span class="punctuationbracket text-base max-md:text-sm">(</span>
      <span class="Number text-base max-md:text-sm">0</span>
      <span class="Delimiter text-base max-md:text-sm">,</span>
      <span class="space">&nbsp;</span>
      <span class="Number text-base max-md:text-sm">0</span>
      <span class="Delimiter text-base max-md:text-sm">,</span>
      <span class="space">&nbsp;</span>
      <span class="Number text-base max-md:text-sm">0</span>
      <span class="punctuationbracket text-base max-md:text-sm">)</span>
    </div>
    <div class="line">
      <span class="space"></span>
      <span class="variable text-base max-md:text-sm">vim</span>
      <span class="Delimiter text-base max-md:text-sm">.</span>
      <span class="Function text-base max-md:text-sm">print</span>
      <span class="punctuationbracket text-base max-md:text-sm">(</span>
